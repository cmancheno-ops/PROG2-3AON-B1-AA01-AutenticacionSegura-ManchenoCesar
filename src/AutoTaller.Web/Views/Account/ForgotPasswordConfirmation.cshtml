@inject IWebHostEnvironment Env
@{ ViewData["Title"] = "Solicitud enviada"; }
<h2>Revise su correo</h2>
<p>Si el correo corresponde a una cuenta activa, enviamos un enlace para restablecer la contraseña.</p>
@if (Env.IsDevelopment())
{
  <div class="alert alert-warning">Modo desarrollo: el correo es <strong>simulado</strong>. Ábralo en <a asp-controller="Dev" asp-action="Outbox">/Dev/Outbox</a>.</div>
}
